# App URL (used for webhooks, Stripe redirects)
NEXT_PUBLIC_APP_URL=https://godotforge.dev

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://ogaixeyzowluhajbauvq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (used by waitlist API, admin operations)
SUPABASE_URL=https://ogaixeyzowluhajbauvq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Inngest (build queue)
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Railway (build runner)
RAILWAY_API_TOKEN=your-railway-api-token
RAILWAY_PROJECT_ID=your-railway-project-id
RAILWAY_ENVIRONMENT_ID=your-railway-environment-id
GODOT_BUILDER_IMAGE=ghcr.io/godotforge/godot-builder:4.3

# Stripe (billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_INDIE_PRICE_ID=price_...

# Deploy credential encryption (32 bytes as hex = 64 chars)
# Generate with: openssl rand -hex 32
DEPLOY_ENCRYPTION_KEY=your-64-char-hex-key
